[Unit]
Description=T-Display-S3 USB display: system monitor
After=multi-user.target

[Service]
Type=simple
# Set the port explicitly when more than one display is attached:
# Environment=TDISPLAY_PORT=/dev/tdisplay
ExecStart=/usr/bin/python3 /usr/local/bin/tdisplay-sysmon --interval 2
Restart=always
RestartSec=5
# Needs access to the TTY: root, or a user in the group from 99-tdisplay.rules
# User=tdisplay
# SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
